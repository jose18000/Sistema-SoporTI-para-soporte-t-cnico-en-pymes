# ==============================================================================
# SoporTI - Variables de Entorno (Plantilla de Configuración)
# Copia este archivo como .env y ajusta los valores necesarios para tu entorno local.
# ==============================================================================

# ENTORNO
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# SEGURIDAD Y JWT (Genera valores aleatorios seguros en producción)
JWT_ACCESS_SECRET=sopori_super_secret_access_jwt_key_2026_dev_only
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=sopori_super_secret_refresh_jwt_key_2026_dev_only
JWT_REFRESH_EXPIRES_IN=7d

# BASE DE DATOS (PostgreSQL 16 + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_USER=soporti_user
DB_PASSWORD=soporti_secure_pass_2026
DB_NAME=soporti_db

# CACHE Y COLAS (Redis + BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SERVICIO DE CORREO LOCAL (Mailpit - $0 Cost)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SoporTI Mesa de Ayuda <soporte@soporti.local>"

# INTELIGENCIA ARTIFICIAL (RAG - Google Gemini API / $0 Free Tier)
# Obtén tu clave gratuita en: https://aistudio.google.com/
GEMINI_API_KEY=tu_clave_gratuita_de_gemini_aqui
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Opcional: Proveedor Local Offline (Ollama - $0 Cost)
# LLM_PROVIDER=gemini # o 'ollama'
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# POLÍTICA DE DATOS PERSONALES (Ley 1581 de 2012 - Colombia)
DATA_PRIVACY_VERSION=v1.0
